# Banco local (sem PostgreSQL) — use esta linha para rodar uvicorn imediatamente:
DATABASE_URL=sqlite:///./pastelaria.db

# SECRET_KEY: gere com secrets.token_urlsafe(48); obrigatoria em producao.
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=
MOTOBOY_WHATSAPP=
GOOGLE_MAPS_API_KEY=
FRONTEND_URL=http://localhost:5500
API_PUBLIC_URL=http://localhost:8000

# Pix online — sandbox usa simulador (não precisa de token)
# Produção: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_SANDBOX=false

APP_ENV=development
DEMO_MODE=false
TAXA_ENTREGA=5
LOJA_NOME=Pastéis Nakachi
LOJA_CONTATO=
LOJA_ENDERECO=
LOJA_HORARIOS=
LOJA_LOGO=
LOJA_BANNER=
LOJA_BANNER_RASPADINHAS=
