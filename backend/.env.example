# Banco local (sem PostgreSQL) — use esta linha para rodar uvicorn imediatamente:
DATABASE_URL=sqlite:///./pastelaria.db

# PostgreSQL local ou Supabase (produção):
# DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/pastelaria
# Supabase (copie em Project Settings > Database > Connection string URI):
# DATABASE_URL=postgresql://postgres.xxxx:SENHA@....pooler.supabase.com:6543/postgres

SECRET_KEY=sua-chave-secreta-aqui
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
ADMIN_TOKEN=admin-token-secreto
MOTOBOY_WHATSAPP=5518997640335
GOOGLE_MAPS_API_KEY=
FRONTEND_URL=http://localhost:5500
API_PUBLIC_URL=http://localhost:8000

# Mercado Pago (Checkout Pro) — use credenciais de TESTE primeiro
# Painel: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_SANDBOX=true
