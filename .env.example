# Copie para .env na raiz do projeto: cp .env.example .env

# Senha do PostgreSQL no Docker (mude em producao)
POSTGRES_PASSWORD=

# URL publica do site (IP ou dominio, sem barra no final)
FRONTEND_URL=http://SEU_IP_OU_DOMINIO
API_PUBLIC_URL=http://SEU_IP_OU_DOMINIO

# SECRET_KEY: gere com secrets.token_urlsafe(48); obrigatoria em producao.
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=
MOTOBOY_WHATSAPP=
GOOGLE_MAPS_API_KEY=

# Mercado Pago — use true para simulador Pix no VPS de teste
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_SANDBOX=false

APP_ENV=development
DEMO_MODE=false
TAXA_ENTREGA=5
LOJA_NOME=Pastéis Nakachi
LOJA_CONTATO=
LOJA_ENDERECO=
LOJA_HORARIOS=
LOJA_LOGO=
LOJA_BANNER=
LOJA_BANNER_RASPADINHAS=
