# Copie para .env na raiz do projeto: cp .env.example .env

# Senha do PostgreSQL no Docker (mude em producao)
POSTGRES_PASSWORD=pastelaria

# URL publica do site (IP ou dominio, sem barra no final)
FRONTEND_URL=http://SEU_IP_OU_DOMINIO
API_PUBLIC_URL=http://SEU_IP_OU_DOMINIO

SECRET_KEY=gere-uma-chave-longa-e-aleatoria
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
ADMIN_TOKEN=seu-admin-token
MOTOBOY_WHATSAPP=5518997640335
GOOGLE_MAPS_API_KEY=

# Mercado Pago — use true para simulador Pix no VPS de teste
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_SANDBOX=true
