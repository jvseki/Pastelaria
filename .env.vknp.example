# Template para o servidor VKNP — copie para .env: cp .env.vknp.example .env

POSTGRES_PASSWORD=

# IP ou dominio do VKNP (sem barra no final)
FRONTEND_URL=http://SEU_IP_VKNP
API_PUBLIC_URL=http://SEU_IP_VKNP

# SECRET_KEY: gere com secrets.token_urlsafe(48); obrigatoria em producao.
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=
MOTOBOY_WHATSAPP=
GOOGLE_MAPS_API_KEY=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_SANDBOX=false

APP_ENV=development
DEMO_MODE=false
TAXA_ENTREGA=5
LOJA_NOME=Pastéis Nakachi
LOJA_CONTATO=
LOJA_ENDERECO=
LOJA_HORARIOS=
LOJA_LOGO=
LOJA_BANNER=
LOJA_BANNER_RASPADINHAS=
